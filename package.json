{
  "name": "better-auth-oidc",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "license": "MIT",
  "description": "OIDC-only SSO plugin for Better Auth — no Node.js APIs required",
  "keywords": [
    "sso",
    "auth",
    "oidc",
    "openid",
    "openid-connect",
    "single-sign-on",
    "better-auth"
  ],
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ],
      "client": [
        "./dist/client.d.mts"
      ]
    }
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.14",
    "jose": "^6.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-auth": ">=1.4.0",
    "better-call": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "better-auth": "^1.5.0",
    "better-call": "^1.0.5",
    "tsdown": "^0.12.4",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
