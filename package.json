{
  "name": "@startino/better-auth-oidc",
  "version": "0.1.10",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "description": "OIDC-only SSO plugin for Better Auth with no Node.js API dependencies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startino/better-auth-oidc.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sso",
    "auth",
    "oidc",
    "openid",
    "openid-connect",
    "single-sign-on",
    "better-auth"
  ],
  "module": "dist/index.js",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.14",
    "jose": "^6.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-auth": ">=1.4.0",
    "better-call": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "better-auth": "^1.5.0-beta.13",
    "better-call": "^1.0.5",
    "tsdown": "^0.12.4",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
